# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGO_INITDB_DATABASE=nexora_analytics

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
