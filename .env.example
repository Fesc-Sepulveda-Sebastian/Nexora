# Nexora Environment Configuration
ENV=development
PROJECT_NAME="Nexora API"
VERSION="1.0.0"

# Ports (Configured to avoid conflicts with existing local services)
POSTGRES_PORT=5433
MONGO_PORT=27017
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9006
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend API URL (/api/v1 uses same-origin nginx proxy in Docker/production; override for split-origin)
VITE_API_URL=/api/v1

# PostgreSQL
POSTGRES_USER=nexora_user
POSTGRES_PASSWORD=nexora_secret_2026
POSTGRES_DB=nexora_db
DATABASE_URL=postgresql://nexora_user:nexora_secret_2026@localhost:5433/nexora_db

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGO_INITDB_DATABASE=nexora_analytics

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9005
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9005
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=nexora-evidence
MINIO_SECURE=false
LOCAL_STORAGE_DIR=./uploads

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Security (REQUIRED: set a strong >= 32-char random value in ENV=production)
SECRET_KEY=replace-with-32-plus-char-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
